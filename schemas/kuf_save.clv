package kuf_save;

import "sox_item_type_info.clv";
import "sox_item_att_info.clv";
import "sox_skill_info.clv";
import "sox_resist_info.clv";

// Save file format for Kingdom Under Fire: The Crusaders (PC port).
// This is the ONLY save format used on PC. The binary also contains a
// "Campaign Save" format (WriteCampaignSave, 0x00626d60) but it is
// dead code — the Xbox memory unit UI that allocates its data buffer
// was never implemented for PC. See SAVE_FORMAT.md for details.
//
// Saves are created from the world map between missions.
// The file uses a 4-byte size prefix (Xbox memory card remnant)
// and is zero-padded to 32KB (0x8000 bytes of stream data).
format KufSave {
    root      = File;
    title     = "Kingdom Under Fire: Crusaders - Save File";
    extension = "sav";
    endian    = little;
}

enum UCD : u32 {
    Player  = 0;
    Enemy   = 1;
    Ally    = 2;
    Neutral = 3;
}

// 64-byte equipment/ability slot. Each unit has 6 slots:
// leader weapon, leader accessory, leader armor,
// troop weapon, troop accessory, troop armor.
struct EquipmentSlot {
    auto_id          u32;
    item_type_id     i32  [ref = ItemTypeInfoRecord.field_00];
    level            u16;
    enhancement_tier i16;
    variant_index    u16;
    item_power       i16;
    equipped_flag    u16;
    reserved         u16;
    attribute1_index i32  [ref = ItemAttInfoRecord.attribute_id];
    attribute2_index i32  [ref = ItemAttInfoRecord.attribute_id];
    skill_type_1     SkillType;
    skill_bonus_1    i32;
    skill_type_2     SkillType;
    skill_bonus_2    i32;
    resist_type_1    ResistType;
    resist_bonus_1   i32;
    resist_type_2    ResistType;
    resist_bonus_2   i32;
    slot_category    i32;
}

// Per-unit save data. 483 bytes per unit.
struct UnitSaveData {
// Runtime 0x24, default -1. Name resolution discriminator:
//   < 0 → hero/story character (name from CharInfo.sox via GetCharInfoName)
//   >= 0 → generated leader (name from LeaderGeneration_ENG.sox via GetLeaderGenName,
//           indexed by [troop_info_index][leader_name_index])
    leader_name_index     i32;
// Runtime 0x28
    troop_info_index      u32;
// Runtime 0x2C. K2_JOB_TYPE enum or CharInfo index (>=43)
    job_type              u32;
// Runtime 0x30, sub_type
    model_id              u32;
// Runtime 0x34
    stg_field_190         u32;
// Runtime 0x38
    stg_field_192         u32;
// Runtime 0x3C
    stg_field_194         u32;
// Runtime 0x40
    stg_field_198         u32;
// Runtime 0x20, unit identity from STG byte 0x56.
// Universal linking field: connects barracks units to mission slots via the
// deployment table (built during briefing, 8-byte entries with two int16 char_ids).
    char_id               u32;
// Runtime 0x48, from STG offset 0x1C0
    troop_info_index_2    u32;
// Runtime 0x4C
    ucd                   UCD;
// Runtime 0x44 (written out of sequential order)
    formation_type        u32;
// Runtime 0x50
    grid_config           u32;
// Runtime 0x54, computed by CalcUnitSkillLevel
    skill_level           u32;
// Runtime 0x58, default 0x01
    byte_58               u8;
// Runtime 0x59. 0=hero, 1=troop
    hero_flag             u8;
// Runtime 0x5A, default 0x01
    byte_5a               u8;
    field_60              u32;
    field_64              u32;
    field_68              u32;
// Unit skill profile: 4 entries × 6 bytes (skill_type i16, skill_bonus i16, padding i16).
// Accumulated from leader equipment during deployment via CopyEquipmentToDeployment.
    skill_data            bytes[24];
// Leader's personal equipment (weapon, accessory, armor)
    leader_weapon         EquipmentSlot;
    leader_accessory      EquipmentSlot;
    leader_armor          EquipmentSlot;
// Troop soldiers' equipment (weapon, accessory, armor)
    troop_weapon          EquipmentSlot;
    troop_accessory       EquipmentSlot;
    troop_armor           EquipmentSlot;
    field_504             u32;
}

// World map node state entry (8 bytes saved from 0x7C-byte in-memory records).
// Each represents a map location (castle, town, checkpoint), NOT a unit.
struct WorldMapNodeState {
    byte_61  u8;
    byte_60  u8;
    byte_62  u8;
    byte_63  u8;
    uint_64  u32;
}

struct File {
// File size in bytes (memory card format remnant).
// Note: game validates size_prefix == file_size at runtime.
    size_prefix           u32;
// Save format magic number (0x6E = 110)
    magic                 u32                       [
        (builtin).cel = {
            id: "magic.check"
            message: "save magic must be 0x6E"
            expression: "this == 0x6E"
        }
    ];
// Save context (1080 bytes): slot name, timestamp, display strings
    context_data          bytes[0x438];
// 0=Hironeiden/Gerald, 1=Vellond/Lucretia, 2=Ecclesia/Kendal, 3=Dark Legion/Regnier
    campaign_index        u32                       [
        (builtin).cel = {
            id: "campaign_index.max"
            message: "campaign index must be at most 3"
            expression: "this <= 3"
        }
    ];
// Main save data block (340 bytes from game state object at +0xA4)
    main_save_block       bytes[0x154];
// The unit array IS the player's barracks — all accumulated units across the campaign.
    unit_count            u32;
    units                 UnitSaveData[unit_count];
// Matched against world map node records during load (NOT a unit index).
    selected_unit_ref     u32;
// World map node state. These are map locations (0x7C bytes each in memory),
// NOT unit roster entries. Populated from WMBLOCKINFO blocks by ReadWorldMapBlockData.
    roster_count          u32;
    roster_entries        WorldMapNodeState[roster_count];
    second_array_count    u32;
// Hash-map key references
    second_array          u32[second_array_count];
// Mission completion flags (20 entries from DAT_00743960, 0x4C stride)
    mission_completion    u32[20];
    current_mission_slot  u32;
// Remaining data: mission state (variable-length, NOT self-describing),
// campaign-specific data (5 or 50 bytes), script object array, zero padding.
// Cannot be structurally parsed without runtime STG context.
    tail_data             bytes                     [rest = true];
}
