package sox_custom_random_table;

import "common.clv";

// Custom random probability table. Non-standard SOX layout with
// a 7-entry lookup table, separator, and 9 data records.
// Not referenced by Kuf2Main.exe; likely an unused development remnant.
format SoxCustomRandomTable {
    root      = File;
    title     = "Kingdom Under Fire: Crusaders - KUF2CustomRandomTable.sox";
    extension = "sox";
    endian    = little;
}

// 4-field entry in the lookup table preceding the data records.
struct LookupEntry {
// Flag or type (observed: 0 or 1)
    field_0  u32;
// Index or ID (observed: 1-6)
    field_1  u32;
// Value (observed: 1-6, often matches field_1)
    field_2  u32;
// Count or category (observed: 1-3)
    field_3  u32;
}

// Data record: 6 prefix fields + 24 table slots.
// Table slot value 999999 means unused/default.
struct RandomTableRecord {
// Always 0
    field_0      u32;
// Always 0
    field_1      u32;
// Category (observed: 3)
    field_2      u32;
// Observed: 1
    field_3      u32;
// Observed: 1
    field_4      u32;
// Observed: 1
    field_5      u32;
// Probability/value slots (999999 = unused)
    table_slots  u32[24];
}

struct File {
    header           SoxHeader;
// First header string (observed: '6000')
    header_string_0  Lps;
// Second header string (observed: '7002')
    header_string_1  Lps;
    lookup_entries   LookupEntry[7];
// Separator between lookup table and data records (always 0)
    separator        u32;
    records          RandomTableRecord[9];
// THEND + space padding
    footer           bytes[64];
}
