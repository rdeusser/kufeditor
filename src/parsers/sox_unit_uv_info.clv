package sox_unit_uv_info;

import "common.clv";

// Unit UV texture coordinate and animation data. 109 records.
// Actual record size is 36 bytes (9 x u32), not 32 as stated in
// some community documentation.
format SoxUnitUvInfo {
    root      = File;
    title     = "Kingdom Under Fire: Crusaders - UnitUVInfo.sox";
    extension = "sox";
    endian    = little;
}

// 36 bytes per record: 9 x u32.
struct UnitUvInfoRecord {
    unknown_0        u32;
    base_value       u32;
    uv_offset_x      u32;
    uv_offset_y      u32;
    uv_scale         u32;
    anim_frame_data  u32;
    anim_timing      u32;
    frame_count      u32;
// Additional field not in original documentation
    unknown_8        u32;
}

struct File {
    header   SoxHeader;
    records  UnitUvInfoRecord [count = header.record_count];
// THEND + space padding
    footer   bytes[64];
}
