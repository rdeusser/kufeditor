package sox_worldmap_char_info;

import "common.clv";

// World map character display data. 63 records defining character
// rendering on the world map screen. Serves as a fallback name
// source when CharInfo.sox is not loaded.
format SoxWorldmapCharInfo {
    root      = File;
    title     = "Kingdom Under Fire: Crusaders - WorldMap_CharInfo.sox";
    extension = "sox";
    endian    = little;
}

// 28 bytes per record: 7 x i32.
struct WorldmapCharInfoRecord {
    character_id       i32;
// -1 = none
    primary_slot_id    i32;
// -1 = none
    secondary_slot_id  i32;
// -1 = none
    unknown_3          i32;
// -1 = none
    unknown_4          i32;
    portrait_id_1      i32;
    portrait_id_2      i32;
}

struct File {
    header   SoxHeader;
    records  WorldmapCharInfoRecord [count = header.record_count];
// THEND + space padding
    footer   bytes[64];
}
